# AM Motors storefront — server-side environment template.
# Copy to .env.local for local work. NEVER commit real values. NEVER use a NEXT_PUBLIC_ prefix
# for any of these: they must stay on the server.
#
# With INVENTORY_SOURCE unset the site shows "inventory temporarily unavailable" (no fixtures).

# Data source: "google-sheets" to read the Sheet "AM Motors — Справочник машин" (tab "Машины").
INVENTORY_SOURCE=

# Spreadsheet ID (the part of the Sheet URL between /d/ and /edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Auth mode:
#   vercel-oidc          — recommended on Vercel: keyless Workload Identity Federation.
#   service-account-key  — fallback (e.g. local smoke test): service-account JSON key in env.
GOOGLE_AUTH_MODE=

# Dedicated read-only service account; the Sheet is shared with this email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# --- service-account-key mode only ---
# The "private_key" field of the JSON key (literal \n sequences are accepted).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- vercel-oidc mode only ---
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime (or `vercel env pull` locally); do not set it by hand.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# --- Vehicle media (Phase 3) ---
# Unset (default): no Drive access; every vehicle shows "Photos unavailable".
# "google-drive": publish only images in the "Website" child folder of each vehicle's folder
# (Sheet column "Ссылка на фото/видео"); see docs/business-rules.md → "Website photos".
# Requires the folders shared with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer and the Google Drive
# API enabled (docs/google-sheets-setup.md → Drive media). Keep unset in Preview/Production
# until the user explicitly enables it.
MEDIA_SOURCE=
